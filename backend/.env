# Server Configuration
PORT=5000
HOST=localhost
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/jobassist
DB_POOL_SIZE=10
DB_MAX_IDLE_TIME=60000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# File Uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=./storage/uploads
ALLOWED_MIMES=image/jpeg,image/png,application/pdf

# Cloud Storage
CLOUD_PROVIDER=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=jobassist-uploads

# Security
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (Optional)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@jobassist.com

# Payment Configuration (Optional)
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=your_stripe_api_key_here
